# Copiá a `.env.local` y completá valores reales. No subas `.env.local` a Git.

# --- Base de datos (Neon) ---
DATABASE_URL=postgresql://...@...-pooler....neon.tech/neondb?sslmode=require
# Opcional: conexión directa para `npm run db:push` en Windows
# DATABASE_URL_DIRECT=postgresql://...@....neon.tech/neondb?sslmode=require

# --- Correo al reservar (elegí Gmail SMTP o Resend) ---

# Opción A — Gmail ("Enviado desde" tu @gmail.com)
# 1) Cuenta Google → Seguridad → Verificación en 2 pasos (activada)
# 2) Contraseñas de aplicaciones → generá una para "Correo"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=María Emilia Estética <tu-cuenta@gmail.com>
OWNER_EMAIL=tu-cuenta@gmail.com

# Opción B — Resend (OBLIGATORIO en Vercel; Gmail SMTP no funciona ahí)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=María Emilia Estética <onboarding@resend.dev>
# OWNER_EMAIL=tu-gmail@gmail.com

# --- Panel admin ---
ADMIN_SESSION_SECRET=genera-una-clave-larga-aleatoria
ADMIN_PASSWORD=tu-contraseña-de-ingreso

# --- Opcional ---
# APP_TIMEZONE=America/Argentina/Buenos_Aires
# WhatsApp del salón (solo dígitos, ej. 5492215918286) — botón en /reservar
# NEXT_PUBLIC_WHATSAPP_NUMBER=5492215918286
